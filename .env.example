KRILL_API_ADDR=:8080
# Change these three on the box. Postgres only reads its password when its
# volume is first created.
KRILL_POSTGRES_PASSWORD=krill
KRILL_S3_ACCESS_KEY=krill
KRILL_S3_SECRET_KEY=krillkrill
KRILL_DATABASE_URL=postgres://krill:krill@localhost:5432/krill?sslmode=disable
KRILL_S3_ENDPOINT=http://localhost:9000
# Where browsers load frames from. Must be HTTPS when KRILL_PUBLIC_URL is.
KRILL_S3_PUBLIC_ENDPOINT=http://localhost:9000
KRILL_S3_BUCKET=krill
KRILL_PUBLIC_URL=http://localhost:5173
# Admins can change the settings below in the admin panel. Uncommenting one
# here overrides the panel and locks it there.
# KRILL_ALLOW_SIGNUP=true
# Password sign-up needs an email at this domain.
# KRILL_SIGNUP_EMAIL_DOMAIN=wisc.edu
# off accepts any email, domain needs one at KRILL_SIGNUP_EMAIL_DOMAIN, and
# verify also has new accounts enter a code sent to it.
# KRILL_EMAIL_VERIFICATION=domain
# Sends verification and password reset codes. The From domain must be verified
# in Resend. Without a key, a localhost instance writes emails to the API log.
# KRILL_RESEND_API_KEY=
# KRILL_EMAIL_FROM=Krill <noreply@krill.camdenrush.com>
# KRILL_TEAM_NAME=Wisconsin Autonomous Underwater Vehicles
# Sign in with Slack. The Slack app needs the redirect URL
# $KRILL_PUBLIC_URL/auth/slack/callback.
# KRILL_SLACK_CLIENT_ID=
# KRILL_SLACK_CLIENT_SECRET=
# KRILL_SLACK_TEAM_ID=
# Set to CF-Connecting-IP when the app is only reachable through Cloudflare.
# KRILL_CLIENT_IP_HEADER=
# A labeler's work goes to review while their mean score over their last 5 gold
# checks is below the threshold, once they have answered the minimum.
# KRILL_GOLD_REVIEW_THRESHOLD=0.7
# KRILL_GOLD_REVIEW_MIN_ATTEMPTS=3
# Compute SAM image embeddings after ingest, about 8 MB per frame in MinIO with SAM 2.1.
# KRILL_EMBED_AT_INGEST=true
# Look up the latest release on GitHub for the admin panel.
# KRILL_UPDATE_CHECK=true
# Days without edits before the admin panel lists a claimed clip as stuck.
# KRILL_STUCK_CLAIM_DAYS=3
# Shared secret for the GPU worker. Generate one with: openssl rand -hex 32
KRILL_WORKER_TOKEN=
# SAM 3 (facebook/sam3) is gated on Hugging Face and needs HF_TOKEN.
KRILL_SAM_MODEL=facebook/sam2.1-hiera-small
HF_TOKEN=
